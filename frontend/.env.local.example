# Next.js reads: frontend/.env.local (copy this file to .env.local — gitignored)

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Public ngrok tunnel to Django (copy the https URL from `ngrok http 8000`):
# NEXT_PUBLIC_API_BASE_URL=https://abcd-12-34-56.ngrok-free.app/api/v1
# Example if nginx terminates TLS on the instance:
# NEXT_PUBLIC_API_BASE_URL=https://YOUR_EC2_PUBLIC_IP/api/v1
