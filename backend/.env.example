# ─── Django loads ONLY this path: backend/.env (same folder as manage.py) ───
# Copy this file:
#   cp .env.example .env        (Unix)
#   copy .env.example .env        (Windows)
# Then edit .env — never commit .env (see .gitignore).

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Browser URL for links (emails, redirects)
FRONTEND_URL=http://localhost:3000

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@baileyandbeau.local
SUPPORT_EMAIL=support@baileyandbeau.local

SENTRY_DSN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
LIVEKIT_TOKEN_TTL_MINUTES=120

# STORAGE=server → local MEDIA_ROOT; STORAGE=s3 → requires bucket + AWS keys below
STORAGE=server

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_EXPIRE=3600

# Media — blank MEDIA_ROOT uses default under backend/media when STORAGE=server
MEDIA_URL=/media/
MEDIA_ROOT=
