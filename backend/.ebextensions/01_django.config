# Elastic Beanstalk — optional env + deploy hooks (edit env vars in AWS console).
# When DJANGO_DEBUG=false, set DJANGO_ALLOWED_HOSTS to include your EB URL, e.g.:
#   myapp.eu-north-1.elasticbeanstalk.com

option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: config.settings

container_commands:
  01_migrate:
    command: "python manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    command: "python manage.py collectstatic --noinput"
    leader_only: true
