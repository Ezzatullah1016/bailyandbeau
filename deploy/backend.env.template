# /etc/baileybeau/backend.env  (chmod 600, owned by root)
# Copy this template, fill in real secrets, then place on the server.

DJANGO_SECRET_KEY=__GENERATE_NEW_STRONG_KEY__
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=16.16.146.231,localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://16.16.146.231
DJANGO_CSRF_TRUSTED_ORIGINS=http://16.16.146.231
DJANGO_DEV_CSRF_ORIGINS=

# Browser URL used by Django for emails / redirects
FRONTEND_URL=http://16.16.146.231

# Postgres (local or RDS).  Leave POSTGRES_DB blank to fall back to sqlite for first boot.
POSTGRES_DB=baileybeau
POSTGRES_USER=baileybeau
POSTGRES_PASSWORD=__SET_ME__
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@baileyandbeau.local
SUPPORT_EMAIL=support@baileyandbeau.local

SENTRY_DSN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
LIVEKIT_TOKEN_TTL_MINUTES=120

# STORAGE=server → local MEDIA_ROOT; STORAGE=s3 → AWS keys below
STORAGE=server

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_EXPIRE=3600

MEDIA_URL=/media/
MEDIA_ROOT=/opt/baileybeau/backend/media
