[Unit]
Description=Bailey & Beau — Django (gunicorn)
After=network.target

[Service]
Type=notify
User=ubuntu
Group=www-data
WorkingDirectory=/opt/baileybeau/backend
EnvironmentFile=/etc/baileybeau/backend.env
ExecStart=/opt/baileybeau/backend/.venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/baileybeau-backend.sock \
    --workers 3 \
    --threads 2 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=3
RuntimeDirectory=baileybeau

[Install]
WantedBy=multi-user.target
